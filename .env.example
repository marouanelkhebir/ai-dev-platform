# Copy this file to .env and fill in the required service credentials.
PLATFORM_API_KEY=
OPENAI_BASE_URL=
OPENAI_API_KEY=

JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_WEBHOOK_SECRET=

GITLAB_BASE_URL=
GITLAB_API_TOKEN=
GITLAB_WEBHOOK_SECRET=

# Only needed when a project uses Bitbucket Cloud.
BITBUCKET_BASE_URL=
BITBUCKET_USERNAME=
BITBUCKET_API_TOKEN=

# Only needed when a project uses GitHub. On GitHub Enterprise Server the base URL is the API
# root, e.g. https://ghe.company.com/api/v3.
GITHUB_BASE_URL=
GITHUB_API_TOKEN=
